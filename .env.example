BOT_TOKEN=123456:ABC-your-bot-token
# Supabase / Postgres. postgres:// and postgresql:// are auto-converted to the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres

# Private channel where materials are stored (bot must be an ADMIN there). Looks like -100xxxxxxxxxx
STORAGE_CHANNEL_ID=-1001234567890
# Admin review group/channel where receipts are sent (bot must be a member)
ADMIN_CHAT_ID=-1009876543210
# Comma-separated Telegram user IDs allowed to approve/reject payments and upload materials
ADMIN_IDS=111111111,222222222

# Payment details shown to students
CBE_ACCOUNT=1000123456789
TELEBIRR_NUMBER=0911000000
ACCOUNT_HOLDER=Your Full Name
PRICE_ETB=300
UNIVERSITY_NAME="Addis Ababa University"
COURSES="MATH101:Applied Mathematics I, PHYS101:General Physics, CHEM101:General Chemistry, COMP101:Intro to Computing"
GEMINI_API_KEY=""
